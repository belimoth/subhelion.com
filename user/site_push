#!/bin/bash

set -o errexit

cd /a

[[ -d /a/void/push ]] && rm --force --recursive /a/void/push
cp --recursive /a/code /a/void/push

[[ -d /a/void/push/data ]] && rm --force --recursive /a/void/push/data
cp --recursive /a/void/data /a/void/push/data

set -o noglob

site=s3://www.subhelion.com

cd /a/void/push

set -o xtrace

aws --profile subhelion.com s3 rm                s3://www.subhelion.com --recursive --exclude "data/*"
aws --profile subhelion.com s3 sync /a/void/push s3://www.subhelion.com --exclude "*" --include "*.html" --content-type text/html
aws --profile subhelion.com s3 sync /a/void/push s3://www.subhelion.com --exclude "*" --include "*.js"   --content-type text/javascript
aws --profile subhelion.com s3 sync /a/void/push s3://www.subhelion.com --exclude "*" --include "*.css"  --content-type text/css

# todo maybe another path just to push new data not flush and replace

[[ $1 == all ]] && {
	aws --profile subhelion.com s3 rm                     s3://www.subhelion.com/data --recursive
	aws --profile subhelion.com s3 sync /a/void/push/data s3://www.subhelion.com/data
}

set +o xtrace

dist=E1KQI2QRNN6CYG

aws --profile subhelion.com cloudfront create-invalidation --distribution-id $dist --paths "/*"
