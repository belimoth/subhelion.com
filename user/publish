#!/bin/bash

cd /a

md                     /a/void/push
cp --recursive /a/code /a/void/push

set -o noglob

site=s3://www.subhelion.com

cd /a/void/push

set -o xtrace

aws --profile subhelion.com s3 rm     s3://www.subhelion.com --recursive
aws --profile subhelion.com s3 sync . s3://www.subhelion.com --include "*/*.html" --content-type text/html
aws --profile subhelion.com s3 sync . s3://www.subhelion.com --include "*/*.js"   --content-type text/javascript
aws --profile subhelion.com s3 sync . s3://www.subhelion.com --include "*/*.css"  --content-type text/css

set +o xtrace

dist=E1KQI2QRNN6CYG

aws --profile subhelion.com cloudfront create-invalidation --distribution-id $dist --paths "/*"
